# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file formats
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# Binary media formats (do not modify line endings or diff as text)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text eol=lf
